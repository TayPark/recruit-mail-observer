# Mail Provider IMAP (supported presets: kakao | gmail | naver | custom)
# Backward-compatible KAKAO_EMAIL / KAKAO_APP_PASSWORD aliases are also supported when MAIL_PROVIDER=kakao.
MAIL_PROVIDER=kakao
MAIL_EMAIL=your_id@kakao.com
MAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional overrides (auto-filled from MAIL_PROVIDER when omitted; MAIL_IMAP_HOST required for custom)
# MAIL_IMAP_HOST=imap.kakao.com
# MAIL_IMAP_PORT=993
# MAIL_IMAP_MAILBOX=INBOX

# Slack Incoming Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<TEAM_ID>/<BOT_ID>/<SECRET_TOKEN>

# Notion Integration & Database
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# LLM Classifier
# Default is "none" (rule-only local classification, no email content sent to external LLM).
# Set to "gemini" or "openai" to explicitly enable cloud LLM classification.
LLM_PROVIDER=none
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gemini-4-hydrogen
GEMINI_THINKING_LEVEL=low

# Pipeline options
LOOKBACK_DAYS=7
MIN_CONFIDENCE=0.65
MATCH_BY_ROLE=false
STATE_FILE=state/processed_messages.json
